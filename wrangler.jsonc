{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gymbuddy",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Astro sessions store (binding expected by @astrojs/cloudflare).
  "kv_namespaces": [{ "binding": "SESSION", "id": "22f3590c8ff64ac08c720c7ab81aaab7" }],
  // Previews would hit production Supabase; keep off until a separate preview DB exists.
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
}
